          "« Viens-tu ? »",
          "Il demande SI je viens."
        ],
        [
          "Con QUI",
          "« Qui est-ce ? »",
          "Il demande QUI c'est."
        ],
        [
          "Con QUE / QU'EST-CE QUE",
          "« Que fais-tu ? »",
          "Il demande CE QUE je fais."
        ],
        [
          "Con OÙ",
          "« Où vas-tu ? »",
          "Il demande OÙ je vais."
        ],
        [
          "Con QUAND",
          "« Quand pars-tu ? »",
          "Il demande QUAND je pars."
        ],
        [
          "Con COMMENT",
          "« Comment vas-tu ? »",
          "Il demande COMMENT je vais."
        ],
        [
          "Con POURQUOI",
          "« Pourquoi es-tu là ? »",
          "Il demande POURQUOI je suis là."
        ],
        [
          "Con COMBIEN",
          "« Combien coûte-t-il ? »",
          "Il demande COMBIEN il coûte."
        ],
        [
          "Con QUEL(LE)",
          "« Quel est ton nom ? »",
          "Il demande QUEL est mon nom."
        ]
      ],
      "note": "⚠️ Points clés: Est-ce que → SI. Qu'est-ce que → CE QUE. L'inversion sujet-verbe disparaît. Les guillemets et les points d'interrogation disparaissent."
    },
